# Copy to .env.local. Never commit real values.

# Postgres (docker compose up -d db)
DATABASE_URL=postgres://schema_guard:schema_guard@127.0.0.1:54329/schema_guard

# --- Worker host only (never needed by the dashboard / Vercel) ---
# live    = every agent turn goes through OpenClaw; provider failures are surfaced, never papered over
# fixture = canned deterministic agent output, labelled "Fixture mode"
# auto    = try live first; on a provider failure fall back to fixture output and label the turn
AGENT_MODE=auto
OPENCLAW_BIN=~/.openclaw/bin/openclaw
OPENCLAW_PROFILE=schema-guard
OPENCLAW_GATEWAY_PORT=18795
# Resolved model reference used by every project role
OPENCLAW_MODEL=cerebras/moonshotai-kimi-k3.1-pro-trial
# Kimi K3.1 Pro on Cerebras accepts only "off" or "ultra"
OPENCLAW_THINKING=off
OPENCLAW_TIMEOUT_SECONDS=75
# Role agent ids (created by `npm run openclaw:setup`)
OPENCLAW_AGENT_INVESTIGATOR=sg-investigator
OPENCLAW_AGENT_REPAIR=sg-repair
OPENCLAW_AGENT_ORDERS_AUTHOR=sg-orders-author
OPENCLAW_AGENT_PAYMENTS_AUTHOR=sg-payments-author
OPENCLAW_AGENT_SHIPPING_AUTHOR=sg-shipping-author

# Worker limits
WORKER_RUN_CONCURRENCY=1
SCENARIO_AUTHOR_CONCURRENCY=3
JOB_LEASE_SECONDS=60
AGENT_MAX_ATTEMPTS=2

# Secrets, worker host only. Referenced by the OpenClaw profile as ${...}; never written to its config.
CEREBRAS_API_KEY=
OPENCLAW_GATEWAY_TOKEN=
