    },
    {
      "name": "order_id",
      "type": "string",
      "required": true,
      "nullable": false,
      "semantic": "Order being fulfilled",
      "unit": null
    },
    {
      "name": "carrier",
      "type": "string",
      "required": true,
      "nullable": false,
      "semantic": "Carrier code",
      "unit": null
    },
    {
      "name": "status",
      "type": "string",
      "required": true,
      "nullable": false,
      "semantic": "shipped or delivered",
      "unit": null
    },
    {
      "name": "shipped_at",
      "type": "timestamp",
      "required": true,
      "nullable": false,
      "semantic": "Dispatch time (UTC)",
      "unit": null
    }
  ],
  "semantics": {},
  "delivery": {
    "expected_start_min": 30,
    "expected_progress_min": 60,
    "hard_deadline_min": 180,
